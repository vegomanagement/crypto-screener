# Copied to /opt/crypto-screener/.env (chmod 600) on first deploy; never overwritten afterwards.
# Placeholders only — real values are edited on the server, never committed.

# Workers: deploy with both OFF, migrate the DBs, then flip to 1 and run ./deploy.sh again.
# Each takes a flock on its DB, so exactly one process may run them (the local server must
# have them OFF once the VPS owns the files).
PAPER_JOURNAL=0
WHALE_RECORDER=0

# Hermes LLM analyst. There is no Hermes API on the VPS, so leave these EMPTY: the analyst
# then answers "unavailable" (null + reason, UI shows —) instead of failing.
HERMES_API_URL=
HERMES_API_KEY=
# HERMES_MODEL=

# Optional tuning (defaults in code):
# PAPER_INTERVAL_MIN=15
# WHALE_INTERVAL_MIN=5
# PAPER_UNIVERSE=

# Telegram is deliberately not supported in this deployment (run.py removes the token).
